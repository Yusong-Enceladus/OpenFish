          },
          {
            "id": "tools",
            "kind": "tool-runtime",
            "title": "Tool runtime",
            "editable": false,
            "responsibility": "Publishes active tools, validates arguments, and records structured results.",
            "inputs": [
              "tool request",
              "active catalog"
            ],
            "outputs": [
              "tool result",
              "render intent"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/core/tools",
                "version": "0.1.0-x.0"
              }
            ],
            "observes": [
              "tool.activity"
            ]
          },
          {
            "id": "sandbox",
            "kind": "execution-boundary",
            "title": "Execution boundary",
            "editable": false,
            "responsibility": "Applies the active sandbox provider to operations that request confinement; exact enforcement depends on the selected provider and policy.",
            "inputs": [
              "approved operation",
              "workspace policy"
            ],
            "outputs": [
              "enforced or reported effect"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/sandbox",
                "version": "0.1.0-x.0"
              }
            ]
          },
          {
            "id": "approvals",
            "kind": "permission-policy",
            "title": "Approvals",
            "editable": false,
            "responsibility": "Stops sensitive operations until the configured policy or user grants permission.",
            "inputs": [
              "operation risk",
              "preset policy"
            ],
            "outputs": [
              "allow or deny decision"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/guard",
                "version": "0.1.0-x.0"
              }
            ],
            "observes": [
              "approval.requested",
              "approval.resolved"
            ]
          },
          {
            "id": "session",
            "kind": "session-runtime",
            "title": "Session persistence",
            "editable": false,
            "responsibility": "Persists events, selected Harness identity, and resumable conversation state.",
            "inputs": [
              "agent events",
              "control state"
            ],
            "outputs": [
              "durable session",
              "replay"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/session",
                "version": "0.1.0-x.0"
              }
            ]
          },
          {
            "id": "extensions",
            "kind": "plugin-runtime",
            "title": "Plugin composition",
            "editable": false,
            "responsibility": "Composes optional capabilities without changing the core agent loop.",
            "inputs": [
              "plugin manifests",
              "configuration"
            ],
            "outputs": [
              "capability graph"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/core",
                "version": "0.1.0-x.0"
              }
            ]
