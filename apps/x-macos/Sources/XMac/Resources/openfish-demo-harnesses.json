          {
            "id": "context",
            "kind": "context-runtime",
            "title": "Context assembly",
            "editable": false,
            "responsibility": "Builds the model-visible prompt from instructions, workspace context, skills, and session history.",
            "inputs": [
              "user intent",
              "workspace",
              "session history"
            ],
            "outputs": [
              "model context"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/context",
                "version": "0.1.0-x.0"
              }
            ]
          },
          {
            "id": "loop",
            "kind": "agent-loop",
            "title": "Agent loop",
            "editable": false,
            "responsibility": "Coordinates inference, tool calls, approvals, and turn termination.",
            "inputs": [
              "model context",
              "session controls"
            ],
            "outputs": [
              "assistant events",
              "tool requests"
            ],
            "evidence": [
              {
                "kind": "source-derived",
                "source": "packages/core/agent-loop",
                "version": "0.1.0-x.0"
