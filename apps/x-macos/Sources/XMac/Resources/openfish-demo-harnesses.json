            "observes": [
              "turn.started",
              "turn.completed",
              "turn.failed"
            ]
          },
          {
            "id": "models",
            "kind": "model-router",
            "title": "Model routing",
            "editable": false,
            "responsibility": "Resolves a configured provider, model, and reasoning controls for each inference request.",
